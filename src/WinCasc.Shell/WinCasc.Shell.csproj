<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinCascShell</AssemblyName>
    <OutDir Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildThisFileDirectory)..\WinCasc\bin\$(Configuration)\$(TargetFramework)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinCasc\WinCasc.csproj" />
  </ItemGroup>

</Project>
