<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CascLibSourceDir>$(MSBuildThisFileDirectory)..\..\ext\CascLib\</CascLibSourceDir>
    <CascLibBuildDir>$(MSBuildThisFileDirectory)..\..\artifacts\casclib\</CascLibBuildDir>
    <CascLibDll>$(CascLibBuildDir)Release\CascLib.dll</CascLibDll>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinCascShell" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="winfsp-msil">
      <HintPath>$(MSBuildProgramFiles32)\WinFsp\bin\winfsp-msil.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <CascLibSources Include="$(CascLibSourceDir)src\**\*.cpp;$(CascLibSourceDir)src\**\*.c;$(CascLibSourceDir)src\**\*.h;$(CascLibSourceDir)CMakeLists.txt" />
  </ItemGroup>

  <Target Name="BuildCascLib" BeforeTargets="BeforeBuild" Inputs="@(CascLibSources)" Outputs="$(CascLibDll)">
    <Exec Command="cmake -S &quot;$(CascLibSourceDir).&quot; -B &quot;$(CascLibBuildDir).&quot; -A x64 -DCASC_UNICODE=ON -DCASC_BUILD_SHARED_LIB=ON -DCMAKE_POLICY_VERSION_MINIMUM=3.5" />
    <Exec Command="cmake --build &quot;$(CascLibBuildDir).&quot; --config Release" />
  </Target>

  <ItemGroup>
    <None Include="$(CascLibDll)" Link="CascLib.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
